static volatile uint32_t *a540_fbpage;
static int a540_fbrow;

static bool
a540_hang_asked(void)
{
	uint32_t asked = 0;

	if (PE_parse_boot_argn("chiron_gpu_hang", &asked, sizeof(asked))) {
		return asked != 0;
	}
	return false;
}

static void
a540_fb_reset(void)
{
	uint32_t i;

	a540_fbpage = (volatile uint32_t *)ml_io_map(A540_FB_PHYS, A540_FB_PIXELS * 4);
	if (a540_fbpage == 0) {
		printf("a540: no framebuffer to draw on\n");
		return;
	}
	/* the panel origin, in words */
	a540_fbpage = a540_fbpage + A540_FB_ORIGIN / 4;
	for (i = 0; i < (uint32_t)A540_ROWS * A540_CH_H * A540_FB_W; i++) {
		a540_fbpage[i] = 0xff101010u;
	}
	a540_fbrow = 0;
}

static void
a540_fb_glyph(int col, char ch, uint32_t fg)
{
	const unsigned char *g;
	int x0, y0, gx, gy, sx, sy;

	if (ch < 0x20 || ch > 0x7e) {
		ch = '?';
	}
	if (a540_fbpage == 0 || a540_fbrow >= A540_ROWS) {
		return;
	}
	g = font8x16[ch - 0x20];
	x0 = col * A540_CH_W;
	y0 = a540_fbrow * A540_CH_H;
	for (gy = 0; gy < 16; gy++) {
		for (gx = 0; gx < 8; gx++) {
			uint32_t c = (g[gy] & (0x80 >> gx)) ? fg : 0xff101010u;
			for (sy = 0; sy < A540_SCALE; sy++) {
				volatile uint32_t *p = a540_fbpage + (uint32_t)(y0 + gy * A540_SCALE + sy) * A540_FB_W
				    + x0 + gx * A540_SCALE;
				for (sx = 0; sx < A540_SCALE; sx++) {
					p[sx] = c;
				}
			}
		}
	}
}

static void
a540_fb_text(const char *s, uint32_t fg)
{
	int col = 0;

	while (*s != 0 && col < A540_COLS) {
		a540_fb_glyph(col++, *s++, fg);
	}
	a540_fbrow++;
}

static void
a540_fb_hex(const char *label, uint32_t value, uint32_t fg)
{
	char buf[64];
	int n = 0, shift;

	while (*label != 0 && n < 40) {
		buf[n++] = *label++;
	}
	for (shift = 28; shift >= 0; shift -= 4) {
		uint32_t d = (value >> shift) & 0xf;

		buf[n++] = (char)(d < 10 ? '0' + d : 'a' + (d - 10));
	}
	buf[n] = 0;
	a540_fb_text(buf, fg);
}

static void
a540_fb_pair(const char *label, const char *a, uint32_t va, const char *b, uint32_t vb)
{
	char buf[64];
	int n = 0, shift;

	while (*label != 0 && n < 20) {
		buf[n++] = *label++;
	}
	while (*a != 0 && n < 28) {
		buf[n++] = *a++;
	}
	for (shift = 28; shift >= 0; shift -= 4) {
		uint32_t d = (va >> shift) & 0xf;

		buf[n++] = (char)(d < 10 ? '0' + d : 'a' + (d - 10));
	}
	buf[n++] = ' ';
	while (*b != 0 && n < 40) {
		buf[n++] = *b++;
	}
	for (shift = 28; shift >= 0; shift -= 4) {
		uint32_t d = (vb >> shift) & 0xf;

		buf[n++] = (char)(d < 10 ? '0' + d : 'a' + (d - 10));
	}
	buf[n] = 0;
	a540_fb_text(buf, 0xffffffffu);
}

static void
a540_show_screen(void)
{
	uint32_t i;

	a540_fb_reset();
	if (a540_fbpage == 0) {
		return;
	}
	a540_fb_text("A540 P0 on chiron", 0xff60d0ffu);
	a540_fb_pair("CX_GDSCR=", "", a540_rd(a540_gpucc, A540_GPUCC_CX_GDSCR),
	    "GX_GDSCR=", a540_rd(a540_gpucc, A540_GPUCC_GX_GDSCR));
	a540_fb_hex("GFX3D_CBCR=", a540_rd(a540_gpucc, A540_GPUCC_GFX3D_CBCR), 0xffffffffu);
	a540_fb_pair("GCC_AHB=", "", a540_rd(a540_gcc, A540_GCC_GPU_CFG_AHB),
	    "BIMC=", a540_rd(a540_gcc, A540_GCC_GPU_BIMC_GFX));
	a540_fb_hex("GPU_PLL_VOTES=", a540_rd(a540_gcc, A540_GCC_GPU_PLL_VOTES), 0xffffffffu);
	for (i = 0; i < 4; i++) {
		char label[16];
		int n = 0, shift;

		label[n++] = '3';
		label[n++] = 'D';
		label[n++] = '+';
		label[n++] = '2';
		label[n++] = '0';
		label[n++] = (char)('0' + i * 4);
		label[n++] = '=';
		label[n] = 0;
		a540_fb_pair(label, "", a540_rd(a540_gpu, A540_RBBM_BASE + 16 * i),
		    "+4=", a540_rd(a540_gpu, A540_RBBM_BASE + 16 * i + 4));
	}
	a540_fb_text("photo this screen, then reboot", 0xffffff00u);

	printf("a540: the same numbers are painted on the panel\n");
	if (a540_hang_asked()) {
		printf("a540: chiron_gpu_hang=1: staying here so the panel keeps them\n");
		for (;;) {
			delay(1000);
		}
	}
}
